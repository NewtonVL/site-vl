# Variáveis de ambiente apenas no servidor (NUNCA expor com prefixo VITE_ no navegador)
# Use apenas credenciais de TESTE (TEST-*) durante homologação.

# Persistência durável (PostgreSQL / Supabase PostgREST - somente servidor)
# Em novas integrações, use SUPABASE_SECRET_KEY (sb_secret_...). Chaves legadas SUPABASE_SERVICE_ROLE_KEY também são aceitas.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-supabase-secret-key

# Segurança e assinatura de aceites / documentos / entrega interna
PROPOSAL_SIGNING_SECRET=replace-with-strong-random-server-secret
DOCUMENT_HASH_SALT=replace-with-random-document-salt
DELIVERY_ADMIN_SECRET=replace-with-strong-internal-operator-secret
# Opcional (recomendado): operadores individuais com tokenHash SHA-256
# DELIVERY_OPERATORS_JSON=[{"id":"newton","name":"Newton VL","tokenHash":"<sha256>"}]
# Opcional (quando usar DELIVERY_ADMIN_SECRET): lista de operadores permitidos
# DELIVERY_ALLOWED_OPERATORS=Newton VL,Operador Financeiro

# Isolamento de demonstração (false em produção)
ALLOW_DEMO_PROPOSAL=false

# Consulta opcional de CNPJ (apipj.com.br - somente servidor)
APIPJ_API_KEY=replace-with-apipj-api-key

# Mercado Pago (Tokens de teste podem começar com APP_USR- ou TEST-; use MP_ENVIRONMENT=test)
MP_ENVIRONMENT=test
ALLOW_REAL_CHARGES=false
# Obrigatório em homologação: User ID numérico da conta de teste (Mercado Pago Developers ->
# Suas integrações -> Aplicação -> Credenciais de teste / Contas de teste -> User ID)
MP_TEST_ACCOUNT_ID=replace-with-mercadopago-test-user-id
# Opcional: defina true apenas se exigir conta com tag test_user
MP_REQUIRE_TEST_USER_TAG=false
MERCADOPAGO_ACCESS_TOKEN=APP_USR-or-TEST-sandbox-access-token
MERCADOPAGO_WEBHOOK_SECRET=replace-with-mercadopago-webhook-secret
APP_PUBLIC_URL=https://www.vitrinelocal.com.br
# PROPOSALS_JSON=[{"id":"VL-2026-001","accessTokenHash":"<sha256>",...}]
